# D&D 5E Character Sheet - Environment Variables
# Copy this file to .env and update with your values

# ============================================
# Backend Configuration
# ============================================

# Node Environment (development, production, test)
NODE_ENV=production

# Server Port
PORT=3000

# Database Configuration
DATABASE_URL=mongodb://admin:changeme123@localhost:27017/dnd?authSource=admin

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:80

# External APIs
GOOGLE_SHEETS_API_KEY=
SRD_API_URL=https://www.dnd5eapi.co/api

# File Upload
MAX_FILE_SIZE=20971520
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info

# ============================================
# Frontend Configuration
# ============================================

# API URLs
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=true

# ============================================
# Database Configuration
# ============================================

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme123
MONGO_INITDB_DATABASE=dnd

# ============================================
# Production Settings (Optional)
# ============================================

# SSL/TLS
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domain
# DOMAIN=yourdomain.com

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# Backup Configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# Monitoring
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false