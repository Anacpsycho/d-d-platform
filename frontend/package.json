{
  "name": "dnd-frontend",
  "version": "1.0.0",
  "description": "D&D 5E Character Sheet Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
